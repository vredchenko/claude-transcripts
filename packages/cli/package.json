{
  "name": "@claude-transcripts/cli",
  "version": "0.0.15",
  "type": "module",
  "description": "Claude Transcripts CLI — browse, search, back up, and administer your self-hosted Claude Code session history.",
  "keywords": [
    "claude",
    "claude-code",
    "transcripts",
    "session-history",
    "self-hosted",
    "couchdb",
    "s3",
    "observability",
    "bun",
    "cli"
  ],
  "license": "MIT",
  "author": "vredchenko (https://github.com/vredchenko)",
  "homepage": "https://vredchenko.github.io/claude-transcripts/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vredchenko/claude-transcripts.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/vredchenko/claude-transcripts/issues"
  },
  "bin": {
    "claude-transcripts": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build:bundle": "bun run ../../scripts/build-cli-npm.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@claude-transcripts/shared": "workspace:*",
    "ink": "^6.8.0",
    "react": "^19.2.0",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0"
  }
}
