# Env
.env
.env.local
.env.*.local

# Bun / Node
node_modules/
*.log
.DS_Store

# Build output
dist/
build/
*.tsbuildinfo

# Live config (instance-specific; copied from config/config.template.json)
config/config.json
config/*.local.json

# Backing-service state (bind-mounted by the compose stack)
deploy/data/

# The kustomize secretGenerator input (deploy/k8s/base/.env.template is the committed shape)
deploy/k8s/**/.env

# Generated API clients (regenerated from the OpenAPI spec) ARE committed.
# packages/*/src/api/generated.ts   # uncomment if we choose not to commit them
# `openapi.json` is committed too — it is the contract's source of truth (ADR 0019),
# and the contract check needs a baseline in git to compare a change against. CI keeps
# it honest: `gen:clients` rewrites it and a diff fails the build.

# Local hook config / scratch
hooks/.config/

# Browser-suite output: Playwright's traces/artefacts, and the screenshots + report
# from `bun run test:browser:capture`. Both are local diagnostics, regenerated on demand.
tests/browser/.results/
tests/browser/.captures/
playwright-report/

# Placeholder output of scripts/regenerate-compatibility.ts. The generator isn't wired
# to a real Claude Code source yet and stamps `generatedAt`, so committing it would
# churn on every `gen:all`. Track it once the generator produces something stable.
compatibility.json

# Staged into packages/cli at npm-build time by scripts/build-cli-npm.ts
# (npm includes LICENSE from the package dir; the tracked copy is at the repo root).
packages/cli/LICENSE
