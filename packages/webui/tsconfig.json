{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "bun" for the co-located *.test.ts specs (bun:test); the app code itself is
    // browser-only and uses nothing from it.
    "types": ["vite/client", "bun"],
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  // "dev" holds the dev-server helpers (Node, not shipped to the browser); it is kept
  // out of "src" so nothing in the SPA can import a module that reads the filesystem.
  "include": ["src", "dev"]
}
