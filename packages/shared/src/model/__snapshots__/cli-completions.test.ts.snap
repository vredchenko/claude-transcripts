// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`toCompletions bash script matches its snapshot 1`] = `
"# bash completion for claude-transcripts — generated from CLI_SPEC; do not edit.
# Load it with:  eval "$(claude-transcripts completions bash)"   (e.g. in ~/.bashrc)
# Works with bash 3.2+ and needs no bash-completion package.

# Does flag \`cmd:--flag\` ($1) take a value?
_claude_transcripts_valued() {
  case "$1" in
    install:--port-base|install:--webapi|uninstall:--webapi|setup:--webapi|provision:--webapi|stack:--webapi|sessions:--limit|sessions:--cwd|sessions:--model|sessions:--hostname|sessions:--source|sessions:--from|sessions:--to|sessions:--webapi|search:--limit|search:--offset|search:--cwd|search:--model|search:--hostname|search:--source|search:--webapi|turns:--role|turns:--from|turns:--to|turns:--limit|turns:--skip|turns:--webapi|backfill:--dir|backfill:--host|backfill:--actor|backfill:--chunk-size|backfill:--session|backfill:--webapi|export:--since|export:--session|export:--webapi|import:--webapi|migrate:--to|migrate:--steps|migrate:--webapi|reindex:--webapi|doctor:--webapi|hook:--webapi|statusline:--webapi|completions:--webapi) return 0 ;;
  esac
  return 1
}

# The values to offer for $1 — \`cmd:--flag\` or \`cmd:<positional index>\`.
_claude_transcripts_choices() {
  case "$1" in
    stack:1) printf '%s' "up down restart logs ps" ;;
    turns:--role) printf '%s' "user assistant tool_result system other" ;;
    migrate:1) printf '%s' "up down status" ;;
    hook:1) printf '%s' "run install uninstall status" ;;
    statusline:1) printf '%s' "render install uninstall status" ;;
    completions:1) printf '%s' "bash zsh fish" ;;
  esac
}

# The flags command $1 accepts, its own and the global ones.
_claude_transcripts_flags() {
  case "$1" in
    install) printf '%s' "--port-base --meili-key --no-hook --no-statusline --no-app --no-prune --skip-preflight --yes --webapi --help --version" ;;
    uninstall) printf '%s' "--purge --yes --webapi --help --version" ;;
    setup) printf '%s' "--check --no-hook --project --webapi --help --version" ;;
    provision) printf '%s' "--webapi --help --version" ;;
    stack) printf '%s' "--app --volumes --webapi --help --version" ;;
    sessions) printf '%s' "--limit --cwd --model --hostname --source --from --to --json --webapi --help --version" ;;
    search) printf '%s' "--limit --offset --cwd --model --hostname --source --json --webapi --help --version" ;;
    turns) printf '%s' "--role --from --to --limit --skip --json --webapi --help --version" ;;
    backfill) printf '%s' "--dir --host --actor --chunk-size --no-content --force --replace-live --repair --session --dry-run --webapi --help --version" ;;
    export) printf '%s' "--since --session --no-blobs --webapi --help --version" ;;
    import) printf '%s' "--dry-run --no-blobs --webapi --help --version" ;;
    migrate) printf '%s' "--to --steps --dry-run --webapi --help --version" ;;
    reindex) printf '%s' "--webapi --help --version" ;;
    doctor) printf '%s' "--keep --webapi --help --version" ;;
    hook) printf '%s' "--dry-run --force --webapi --help --version" ;;
    statusline) printf '%s' "--dry-run --webapi --help --version" ;;
    completions) printf '%s' "--webapi --help --version" ;;
  esac
}

_claude_transcripts() {
  # Split the line ourselves: COMP_WORDS also breaks at ":" and "=", which would turn
  # \`--webapi http://x\` into four words and miscount everything after it.
  local line="\${COMP_LINE:0:COMP_POINT}" cur cmd npos=0 flag="" i n w
  local -a words
  read -ra words <<<"$line"
  [[ $line == *[[:space:]] || \${#words[@]} -eq 0 ]] && words+=("")
  n=\${#words[@]}
  cur="\${words[n - 1]}"
  COMPREPLY=()
  # \`--flag=value\`: bash replaces only the part after "=", which compgen can't target.
  [[ $cur == *=* ]] && return 0

  if ((n == 2)); then
    if [[ $cur == -* ]]; then
      COMPREPLY=($(compgen -W "--help --version" -- "$cur"))
    else
      COMPREPLY=($(compgen -W "install uninstall setup provision stack sessions search turns backfill export import migrate reindex doctor hook statusline completions" -- "$cur"))
    fi
    return 0
  fi

  # Only the first word is the command; after a leading flag nothing runs a command.
  cmd="\${words[1]}"
  [[ $cmd == -* ]] && return 0

  # Count positionals the way parseFlags reads them: a bare --flag takes the next word
  # as its value unless that word is another --flag.
  for ((i = 2; i < n - 1; i++)); do
    w="\${words[i]}"
    if [[ -n $flag && $w != --* ]]; then
      flag=""
      continue
    fi
    flag=""
    case "$w" in
      --*=*) ;;
      --*) flag="$w" ;;
      *) npos=$((npos + 1)) ;;
    esac
  done

  if [[ -n $flag ]] && _claude_transcripts_valued "$cmd:$flag"; then
    COMPREPLY=($(compgen -W "$(_claude_transcripts_choices "$cmd:$flag")" -- "$cur"))
  elif [[ $cur == -* || -n $flag ]]; then
    COMPREPLY=($(compgen -W "$(_claude_transcripts_flags "$cmd")" -- "$cur"))
  else
    COMPREPLY=($(compgen -W "$(_claude_transcripts_choices "$cmd:$((npos + 1))")" -- "$cur"))
  fi
  return 0
}

complete -F _claude_transcripts claude-transcripts
"
`;

exports[`toCompletions zsh script matches its snapshot 1`] = `
"#compdef claude-transcripts
# zsh completion for claude-transcripts — generated from CLI_SPEC; do not edit.
# Load it with:  eval "$(claude-transcripts completions zsh)"   (after compinit, e.g. in ~/.zshrc)
# or save it as \`_claude_transcripts\` in a directory on $fpath.

_claude_transcripts_valued() {
  case $1 in
    (install:--port-base|install:--webapi|uninstall:--webapi|setup:--webapi|provision:--webapi|stack:--webapi|sessions:--limit|sessions:--cwd|sessions:--model|sessions:--hostname|sessions:--source|sessions:--from|sessions:--to|sessions:--webapi|search:--limit|search:--offset|search:--cwd|search:--model|search:--hostname|search:--source|search:--webapi|turns:--role|turns:--from|turns:--to|turns:--limit|turns:--skip|turns:--webapi|backfill:--dir|backfill:--host|backfill:--actor|backfill:--chunk-size|backfill:--session|backfill:--webapi|export:--since|export:--session|export:--webapi|import:--webapi|migrate:--to|migrate:--steps|migrate:--webapi|reindex:--webapi|doctor:--webapi|hook:--webapi|statusline:--webapi|completions:--webapi) return 0 ;;
  esac
  return 1
}

_claude_transcripts_choices() {
  reply=()
  case $1 in
    (stack:1) reply=(up down restart logs ps) ;;
    (turns:--role) reply=(user assistant tool_result system other) ;;
    (migrate:1) reply=(up down status) ;;
    (hook:1) reply=(run install uninstall status) ;;
    (statusline:1) reply=(render install uninstall status) ;;
    (completions:1) reply=(bash zsh fish) ;;
  esac
}

_claude_transcripts_flags() {
  reply=()
  case $1 in
    (install) reply=('--port-base:first port of the block' '--meili-key:generate a Meilisearch master key' '--no-hook:skip Claude Code registration' '--no-statusline:register the hook but not the statusline' '--no-app:skip the app container (run the webapi yourself)' '--no-prune:keep superseded app images' '--skip-preflight:continue past failed preflight checks' '--yes:no prompts; take documented defaults' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (uninstall) reply=('--purge:also delete recorded history (destructive)' '--yes:skip the confirmation prompt' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (setup) reply=('--check:verify an existing install (read-only)' '--no-hook:config + provision stores only (no registration)' '--project:per-repo registration (placeholder — not built)' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (provision) reply=('--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (stack) reply=('--app:include the app container' '--volumes:with \`down\`: delete the data volumes too' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (sessions) reply=('--limit:rows to list (default 50) / transcript entries to preview (default 30)' '--cwd:only this project directory' '--model:only this model' '--hostname:only this host' '--source:only this provenance (live | backfill | …)' '--from:only sessions overlapping at/after this ISO instant' '--to:only sessions overlapping at/before this ISO instant' '--json:print the webapi response as JSON instead of a table' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (search) reply=('--limit:results per section (default: the webapi'\\''s)' '--offset:skip this many results (paging)' '--cwd:only this project directory' '--model:only this model' '--hostname:only this host' '--source:only this provenance (live | backfill | …)' '--json:print the webapi response as JSON instead of a table' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (turns) reply=('--role:only this speaker' '--from:all sessions: only turns at/after this ISO instant' '--to:all sessions: only turns at/before this ISO instant' '--limit:turns to show' '--skip:skip this many (paging)' '--json:print the webapi response as JSON instead of a table' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (backfill) reply=('--dir:transcripts dir (default ~/.claude/projects)' '--host:hostname to attribute (default: this host)' '--actor:actor to attribute the history to' '--chunk-size:entries per chunk doc' '--no-content:byte-range chunks only (no turn content)' '--force:re-process adopted sessions (deletes their derived docs, then rebuilds)' '--replace-live:with --force: also replace live-recorded sessions (loses hook provenance)' '--repair:add what an interrupted write left out of an adopted session: missing chunk docs, or a transcript that never reached S3; leaves summary + events alone' '--session:with --force: re-process only this session' '--dry-run:preview without writing (reads the store, so skips are shown)' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (export) reply=('--since:only docs at/after this ISO timestamp' '--session:only this session id' '--no-blobs:skip S3 transcripts (~1/10th the size)' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (import) reply=('--dry-run:verify the bundle without writing' '--no-blobs:skip transcripts; restore docs only' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (migrate) reply=('--to:with \`up\`: stop at this schema version' '--steps:with \`down\`: how many to undo' '--dry-run:report what would run without writing' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (reindex) reply=('--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (doctor) reply=('--keep:leave the synthetic session behind for inspection' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (hook) reply=('--dry-run:with \`install\`: show the change without writing' '--force:with \`install\`: register even if the plugin already does' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (statusline) reply=('--dry-run:with \`install\`: show the change without writing' '--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
    (completions) reply=('--webapi:webapi base URL (default: $CT_WEBAPI_URL)' '--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)') ;;
  esac
}

_claude_transcripts() {
  local cur=$words[CURRENT] cmd=$words[2] npos=0 flag="" i w
  local -a reply commands
  commands=(
    'install:Set up everything: stores, app, and the Claude Code hook'
    'uninstall:Remove the instance (history is kept unless --purge)'
    'setup:Install/register the hook + generate runtime config'
    'provision:Create the CouchDB databases and the Garage bucket + key'
    'stack:Control the container stack'
    'sessions:List / inspect sessions (via the webapi)'
    'search:Search the corpus'
    'turns:Speaker-split turns: one session, or one speaker across all sessions'
    'backfill:Adopt on-disk ~/.claude transcripts as first-class history'
    'export:Export session data to a portable bundle'
    'import:Restore session data from a portable bundle'
    'migrate:Run CouchDB migrations'
    'reindex:Rebuild the search indexes from CouchDB'
    'doctor:Smoke-test the write/read/search path end-to-end'
    'hook:The Claude Code hook, and its registration'
    'statusline:The Claude Code statusline indicator (recording / off), and its registration'
    'completions:Print a shell completion script to eval or source from your shell'\\''s rc'
  )

  if (( CURRENT == 2 )); then
    if [[ $cur == -* ]]; then
      reply=('--help:show help for a command (alias: -h)' '--version:print the CLI version (alias: -V)')
      _describe -t options option reply
    else
      _describe -t commands 'claude-transcripts command' commands
    fi
    return
  fi

  # Only the first word is the command; after a leading flag nothing runs a command.
  [[ $cmd == -* ]] && return 1

  # Count positionals the way parseFlags reads them: a bare --flag takes the next word
  # as its value unless that word is another --flag.
  for (( i = 3; i < CURRENT; i++ )); do
    w=$words[i]
    if [[ -n $flag && $w != --* ]]; then
      flag=""
      continue
    fi
    flag=""
    case $w in
      (--*=*) ;;
      (--*) flag=$w ;;
      (*) npos=$((npos + 1)) ;;
    esac
  done

  if [[ $cur == --*=* ]]; then
    flag=\${cur%%=*}
    _claude_transcripts_valued "$cmd:$flag" || return 1
    compset -P '*='
  fi

  if [[ -n $flag ]] && _claude_transcripts_valued "$cmd:$flag"; then
    _claude_transcripts_choices "$cmd:$flag"
    if (( $#reply )); then compadd -a reply; else _message value; fi
  elif [[ $cur == -* || -n $flag ]]; then
    _claude_transcripts_flags "$cmd"
    _describe -t options option reply
  else
    _claude_transcripts_choices "$cmd:$((npos + 1))"
    (( $#reply )) && compadd -a reply
  fi
}

if [[ $zsh_eval_context[-1] == loadautofunc ]]; then
  _claude_transcripts "$@"
else
  compdef _claude_transcripts claude-transcripts
fi
"
`;

exports[`toCompletions fish script matches its snapshot 1`] = `
"# fish completion for claude-transcripts — generated from CLI_SPEC; do not edit.
# Load it with:  claude-transcripts completions fish | source   (e.g. in ~/.config/fish/config.fish)
# or save it as ~/.config/fish/completions/claude-transcripts.fish

# Nothing typed after the binary yet: the next word is the command.
function _claude_transcripts_at_command
    test (count (commandline -opc)) -eq 1
end

# The command (the first word, and only the first) is $argv[1].
function _claude_transcripts_in
    set -l t (commandline -opc)
    test "$t[2]" = "$argv[1]"
end

# The word being completed is positional $argv[2] of command $argv[1]. Positionals
# are counted the way parseFlags reads them: a bare --flag takes the next word as its
# value unless that word is another --flag.
function _claude_transcripts_at_positional
    set -l t (commandline -opc)
    test "$t[2]" = "$argv[1]"; or return 1
    set -l npos 0
    set -l flag 0
    for w in $t[3..-1]
        if test $flag = 1; and not string match -q -- '--*' $w
            set flag 0
            continue
        end
        set flag 0
        switch $w
            case '--*=*'
            case '--*'
                set flag 1
            case '*'
                set npos (math $npos + 1)
        end
    end
    test $flag = 0; and test $npos -eq (math $argv[2] - 1)
end

complete -c claude-transcripts -f
complete -c claude-transcripts -n _claude_transcripts_at_command -a install -d 'Set up everything: stores, app, and the Claude Code hook'
complete -c claude-transcripts -n _claude_transcripts_at_command -a uninstall -d 'Remove the instance (history is kept unless --purge)'
complete -c claude-transcripts -n _claude_transcripts_at_command -a setup -d 'Install/register the hook + generate runtime config'
complete -c claude-transcripts -n _claude_transcripts_at_command -a provision -d 'Create the CouchDB databases and the Garage bucket + key'
complete -c claude-transcripts -n _claude_transcripts_at_command -a stack -d 'Control the container stack'
complete -c claude-transcripts -n _claude_transcripts_at_command -a sessions -d 'List / inspect sessions (via the webapi)'
complete -c claude-transcripts -n _claude_transcripts_at_command -a search -d 'Search the corpus'
complete -c claude-transcripts -n _claude_transcripts_at_command -a turns -d 'Speaker-split turns: one session, or one speaker across all sessions'
complete -c claude-transcripts -n _claude_transcripts_at_command -a backfill -d 'Adopt on-disk ~/.claude transcripts as first-class history'
complete -c claude-transcripts -n _claude_transcripts_at_command -a export -d 'Export session data to a portable bundle'
complete -c claude-transcripts -n _claude_transcripts_at_command -a import -d 'Restore session data from a portable bundle'
complete -c claude-transcripts -n _claude_transcripts_at_command -a migrate -d 'Run CouchDB migrations'
complete -c claude-transcripts -n _claude_transcripts_at_command -a reindex -d 'Rebuild the search indexes from CouchDB'
complete -c claude-transcripts -n _claude_transcripts_at_command -a doctor -d 'Smoke-test the write/read/search path end-to-end'
complete -c claude-transcripts -n _claude_transcripts_at_command -a hook -d 'The Claude Code hook, and its registration'
complete -c claude-transcripts -n _claude_transcripts_at_command -a statusline -d 'The Claude Code statusline indicator (recording / off), and its registration'
complete -c claude-transcripts -n _claude_transcripts_at_command -a completions -d 'Print a shell completion script to eval or source from your shell\\'s rc'
complete -c claude-transcripts -n '_claude_transcripts_at_command' -l help -d 'show help for a command (alias: -h)'
complete -c claude-transcripts -n '_claude_transcripts_at_command' -l version -d 'print the CLI version (alias: -V)'

complete -c claude-transcripts -n '_claude_transcripts_in install' -l port-base -x -d 'first port of the block'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l meili-key -d 'generate a Meilisearch master key'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l no-hook -d 'skip Claude Code registration'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l no-statusline -d 'register the hook but not the statusline'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l no-app -d 'skip the app container (run the webapi yourself)'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l no-prune -d 'keep superseded app images'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l skip-preflight -d 'continue past failed preflight checks'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l yes -d 'no prompts; take documented defaults'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l webapi -x -d 'webapi base URL (default: $CT_WEBAPI_URL)'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l help -d 'show help for a command (alias: -h)'
complete -c claude-transcripts -n '_claude_transcripts_in install' -l version -d 'print the CLI version (alias: -V)'

complete -c claude-transcripts -n '_claude_transcripts_in uninstall' -l purge -d 'also delete recorded history (destructive)'
complete -c claude-transcripts -n '_claude_transcripts_in uninstall' -l yes -d 'skip the confirmation prompt'
complete -c claude-transcripts -n '_claude_transcripts_in uninstall' -l webapi -x -d 'webapi base URL (default: $CT_WEBAPI_URL)'
complete -c claude-transcripts -n '_claude_transcripts_in uninstall' -l help -d 'show help for a command (alias: -h)'
complete -c claude-transcripts -n '_claude_transcripts_in uninstall' -l version -d 'print the CLI version (alias: -V)'

complete -c claude-transcripts -n '_claude_transcripts_in setup' -l check -d 'verify an existing install (read-only)'
complete -c claude-transcripts -n '_claude_transcripts_in setup' -l no-hook -d 'config + provision stores only (no registration)'
complete -c claude-transcripts -n '_claude_transcripts_in setup' -l project -d 'per-repo registration (placeholder — not built)'
complete -c claude-transcripts -n '_claude_transcripts_in setup' -l webapi -x -d 'webapi base URL (default: $CT_WEBAPI_URL)'
complete -c claude-transcripts -n '_claude_transcripts_in setup' -l help -d 'show help for a command (alias: -h)'
complete -c claude-transcripts -n '_claude_transcripts_in setup' -l version -d 'print the CLI version (alias: -V)'

complete -c claude-transcripts -n '_claude_transcripts_in provision' -l webapi -x -d 'webapi base URL (default: $CT_WEBAPI_URL)'
complete -c claude-transcripts -n '_claude_transcripts_in provision' -l help -d 'show help for a command (alias: -h)'
complete -c claude-transcripts -n '_claude_transcripts_in provision' -l version -d 'print the CLI version (alias: -V)'

complete -c claude-transcripts -n '_claude_transcripts_at_positional stack 1' -a 'up down restart logs ps'
complete -c claude-transcripts -n '_claude_transcripts_in stack' -l app -d 'include the app container'
complete -c claude-transcripts -n '_claude_transcripts_in stack' -l volumes -d 'with \`down\`: delete the data volumes too'
complete -c claude-transcripts -n '_claude_transcripts_in stack' -l webapi -x -d 'webapi base URL (default: $CT_WEBAPI_URL)'
complete -c claude-transcripts -n '_claude_transcripts_in stack' -l help -d 'show help for a command (alias: -h)'
complete -c claude-transcripts -n '_claude_transcripts_in stack' -l version -d 'print the CLI version (alias: -V)'

complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l limit -x -d 'rows to list (default 50) / transcript entries to preview (default 30)'
complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l cwd -x -d 'only this project directory'
complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l model -x -d 'only this model'
complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l hostname -x -d 'only this host'
complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l source -x -d 'only this provenance (live | backfill | …)'
complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l from -x -d 'only sessions overlapping at/after this ISO instant'
complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l to -x -d 'only sessions overlapping at/before this ISO instant'
complete -c claude-transcripts -n '_claude_transcripts_in sessions' -l json -d 'print the webapi response as JSON instead of a table'
