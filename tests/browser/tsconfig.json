{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // "bun" for capture.ts (import.meta.dir, the script entrypoint); DOM because the
    // audit helpers' `page.evaluate` bodies are compiled as browser code even though
    // the file around them runs in Bun.
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": [".", "../../playwright.config.ts"],
  // Imports CLI source, whose Bun `fetch` calls don't type-check against the DOM lib.
  // It runs no browser code, so it is checked by tsconfig.plugin.json, without DOM.
  "exclude": ["capture-plugin.ts", ".captures"]
}
