{
  "name": "@claude-transcripts/cli",
  "version": "0.0.1",
  "type": "module",
  "description": "Claude Transcripts CLI — browse, search, back up, and administer your self-hosted Claude Code session history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vredchenko/claude-transcripts.git",
    "directory": "packages/cli"
  },
  "bin": {
    "claude-transcripts": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build:bundle": "bun run ../../scripts/build-cli-npm.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@claude-transcripts/shared": "workspace:*",
    "ink": "^5.0.1",
    "react": "^18.3.1",
    "react-devtools-core": "^7.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12"
  }
}
