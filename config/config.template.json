{
  "app": {
    "name": "claude-transcripts"
  },
  "system": {
    "logging": {
      "chunk": { "maxEntriesPerChunk": 200, "flushIntervalMs": 15000 }
    },
    "sessions": { "liveWindowMs": 86400000, "idleThresholdMs": 300000 }
  },
  "couchdb": {
    "databases": {
      "sessions": "claude-transcripts-sessions",
      "appLogs": "claude-transcripts-app-logs"
    }
  },
  "s3": {
    "buckets": {
      "sessions": "claude-transcripts-sessions"
    }
  },
  "meilisearch": {
    "indexes": {
      "sessions": "claude-transcripts-sessions",
      "turns": "claude-transcripts-turns"
    }
  },
  "features": {
    "s3Blobs": true,
    "midFlightChunking": true,
    "couchFullContentChunks": true,
    "meilisearch": true,
    "secretsMasking": false
  },
  "servicesMenu": {
    "couchdbFauxton": "http://127.0.0.1:7652/_utils/",
    "garageWebui": "http://127.0.0.1:7655/",
    "meilisearch": "http://127.0.0.1:7656/"
  },
  "userSettings": {},
  "recall": {
    "mode": "auto",
    "scope": "project",
    "maxResults": 5,
    "maxSnippetChars": 400,
    "triggers": {
      "priorWorkQuestion": true,
      "repeatedError": true,
      "beforeRederiving": true
    },
    "excludeCwdGlobs": [],
    "primer": { "onSessionStart": true, "maxTokens": 200 }
  }
}
